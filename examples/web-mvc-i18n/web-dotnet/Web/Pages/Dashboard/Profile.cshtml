@page "/dashboard/profile"
@model Web.Pages.Dashboard.ProfileModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = L["profile.headline"].Value;
    ViewData["UserEmail"] = Model.UserEmail;
}

@if (Model.User == null)
{
    <div class="card border-0 rounded-4 shadow-sm">
        <div class="card-body text-center text-muted py-5">
            @L["profile.notFound"]
        </div>
    </div>
}
else
{
    <div class="card border-0 rounded-4 shadow-sm">
        <div class="card-header fw-semibold">@L["profile.headline"]</div>
        <div class="card-body">
            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-dark text-white fw-bold"
                     style="width: 80px; height: 80px; font-size: 32px;">
                    @Model.User.Name.ToUpper()[0]
                </div>
                <h5 class="mt-3 mb-0">@Model.User.Name</h5>
                <small class="text-muted">@Model.User.Email</small>
            </div>
            <hr />
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label text-muted small fw-semibold">@L["profile.fullName"]</label>
                    <p class="form-control-plaintext fw-medium">@Model.User.Name</p>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label text-muted small fw-semibold">@L["profile.email"]</label>
                    <p class="form-control-plaintext fw-medium">@Model.User.Email</p>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label text-muted small fw-semibold">@L["profile.userId"]</label>
                    <p class="form-control-plaintext text-muted small">@Model.User.Id</p>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label text-muted small fw-semibold">@L["profile.memberSince"]</label>
                    <p class="form-control-plaintext fw-medium">@Model.User.CreatedAt.ToString("dd MMMM yyyy")</p>
                </div>
            </div>
        </div>
    </div>
}