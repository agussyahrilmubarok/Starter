@page "/sign-up"
@model Web.Pages.SignUpModel
@{
    Layout = "_DefaultLayout";
    ViewData["Title"] = L["auth.signUp.headline"].Value;
}

<div class="min-vh-100 d-flex align-items-center justify-content-center">
    <div class="col-11 col-sm-10 col-md-8 col-lg-5">
        <div class="card border-0 rounded-4 shadow-lg">
            <div class="card-body p-4 p-md-5">
                <h3 class="fw-bold text-center mb-2">@L["auth.signUp.headline"]</h3>
                <p class="text-secondary text-center mb-4">@L["auth.signUp.subtitle"]</p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger rounded-3">@Model.ErrorMessage</div>
                }

                <form method="post">
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <div class="form-group">
                                <label class="form-label fw-semibold">@L["user.name.label"]</label>
                                <input asp-for="Input.Name" type="text"
                                       class="form-control rounded-3 @(ViewData.ModelState["Input.Name"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                       placeholder="@L["user.name.placeholder"]" />
                                <div class="invalid-feedback">
                                    <span asp-validation-for="Input.Name"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <div class="form-group">
                                <label class="form-label fw-semibold">@L["user.email.label"]</label>
                                <input asp-for="Input.Email" type="email"
                                       class="form-control rounded-3 @(ViewData.ModelState["Input.Email"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                       placeholder="@L["user.email.placeholder"]" />
                                <div class="invalid-feedback">
                                    <span asp-validation-for="Input.Email"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <div class="form-group">
                                <label class="form-label fw-semibold">@L["user.password.label"]</label>
                                <input asp-for="Input.Password" type="password"
                                       class="form-control rounded-3 @(ViewData.ModelState["Input.Password"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                       placeholder="@L["user.password.placeholder"]" />
                                <div class="invalid-feedback">
                                    <span asp-validation-for="Input.Password"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button class="btn btn-primary w-100 rounded-4 mt-4" type="submit">
                        @L["auth.signUp.headline"]
                    </button>

                    <div class="text-center mt-3">
                        <span class="text-secondary">@L["auth.signUp.hasAccount"]</span>
                        <a class="text-decoration-none fw-semibold ms-1" href="/sign-in">@L["auth.signIn.headline"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}