@page "/sign-in"
@model Web.Pages.SignInModel
@{
    Layout = "_DefaultLayout";
    ViewData["Title"] = L["auth.signIn.headline"].Value;
}

<div class="min-vh-100 d-flex align-items-center justify-content-center">
    <div class="col-11 col-sm-10 col-md-8 col-lg-5">
        <div class="card border-0 rounded-4 shadow-lg">
            <div class="card-body p-4 p-md-5">
                <h3 class="fw-bold text-center mb-2">@L["auth.signIn.headline"]</h3>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger rounded-3">@Model.ErrorMessage</div>
                }
                @if (TempData["MSG_SUCCESS"] is string successMsg && !string.IsNullOrEmpty(successMsg))
                {
                    <div class="alert alert-success rounded-3">@successMsg</div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@L["user.email.label"]</label>
                        <input asp-for="Input.Email" class="form-control rounded-3" type="email" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@L["user.password.label"]</label>
                        <input asp-for="Input.Password" class="form-control rounded-3" type="password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                    <button class="btn btn-primary w-100 rounded-4 mt-2" type="submit">
                        @L["auth.signIn.headline"]
                    </button>
                    <div class="text-center mt-3">
                        <a class="text-decoration-none fw-semibold ms-1" href="/sign-up">@L["auth.signUp.headline"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}